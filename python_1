from tkinter import *
import mysql.connector
from tkinter import messagebox

def db_connection():
    try:
        mydb = mysql.connector.connect(
            host="localhost",
            user="root",
            password="",
            database="rose_db"
        )
        return mydb
    except mysql.connector.Error as err:
        messagebox.showerror("Database Error", f"{err}")
        return None

def open_welcome():
    welcome_win = Toplevel()
    welcome_win.geometry("370x200")
    welcome_win.title("Welcome")
    welcome_win.config(padx=20, pady=20, bg="#ffffff")

    Label(welcome_win, text="Welcome!", font=('Helvetica', 22, 'bold'), bg="#ffffff", fg="#4CAF50").pack(pady=10)

    mydb = db_connection()
    if mydb:
        messagebox.showinfo("Database", "Connected to Database")
    else:
        messagebox.showerror("Database", "Connection failed!")

    Button(welcome_win, text='Close', command=welcome_win.destroy, bg="#4CAF50", fg="white", font=('Arial', 12, 'bold'), padx=10, pady=5).pack(pady=15)

# Main window
root = Tk()
root.geometry("420x380")
root.title("Timbol Login")
root.config(padx=30, pady=30, bg="#f0f4f8")

# Title label with style
title_label = Label(root, text="Sign In", font=('Helvetica', 24, 'bold'), bg="#f0f4f8", fg="#333")
title_label.pack(pady=20)

# Style for input labels
label_style = {'font': ('Arial', 14), 'bg': '#f0f4f8', 'anchor': 'w'}

# Email Frame
email_frame = Frame(root, bg="#f0f4f8")
email_frame.pack(fill='x', pady=8)
Label(email_frame, text='Email:', **label_style).pack(anchor='w', padx=10)
entry_email = Entry(email_frame, width=35, font=('Arial', 13), bd=2, relief='groove')
entry_email.pack(padx=10, pady=3)

# Password Frame
pass_frame = Frame(root, bg="#f0f4f8")
pass_frame.pack(fill='x', pady=8)
Label(pass_frame, text='Password:', **label_style).pack(anchor='w', padx=10)
entry_pass = Entry(pass_frame, show='*', width=35, font=('Arial', 13), bd=2, relief='groove')
entry_pass.pack(padx=10, pady=3)

# Style for the button
btn_style = {'bg': '#4CAF50', 'fg': 'white', 'activebackground': '#45a049', 'font': ('Arial', 14, 'bold'), 'padx': 15, 'pady': 8, 'bd': 0}
login_btn = Button(root, text='Login', command=open_welcome, **btn_style)
login_btn.pack(pady=25)

# Adding hover effect for button (optional enhancement)
def on_enter(e):
    login_btn['background'] = '#45a049' 

def on_leave(e):
    login_btn['background'] = '#4CAF50'

login_btn.bind("<Enter>", on_enter)
login_btn.bind("<Leave>", on_leave)

root.mainloop()
